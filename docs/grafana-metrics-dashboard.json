    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "description": "Metrics: `stunnel.proxy.connections` · Table: `otel_metrics_sum`",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "0",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT time,\n       pair.1 AS series,\n       sum(pair.2) OVER (PARTITION BY pair.1 ORDER BY time) AS connections\nFROM (\n    SELECT $__timeInterval(TimeUnix) AS time,\n           [('http', sumIf(delta, Attributes['protocol'] = 'http')),\n            ('socks5', sumIf(delta, Attributes['protocol'] = 'socks5'))] AS pairs\n    FROM (\n        SELECT TimeUnix,\n               Attributes,\n               StartTimeUnix,\n               greatest(Value - lagInFrame(Value, 1, 0)\n                        OVER (PARTITION BY MetricName, toString(Attributes), StartTimeUnix\n                              ORDER BY TimeUnix), 0) AS delta\n        FROM otel.otel_metrics_sum\n        WHERE MetricName = 'stunnel.proxy.connections'\n          AND ServiceName = '${client}'\n    )\n    GROUP BY time\n)\nARRAY JOIN pairs AS pair\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Proxy connections, total",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "description": "Metrics: `stunnel.udp.bytes` · Table: `otel_metrics_sum`",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "0",
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT time,\n       pair.1 AS series,\n       sum(pair.2) OVER (PARTITION BY pair.1 ORDER BY time) AS bytes\nFROM (\n    SELECT $__timeInterval(TimeUnix) AS time,\n           [(concat(ServiceName, ' up'), sumIf(delta, Attributes['direction'] = 'up')),\n            (concat(ServiceName, ' down'), sumIf(delta, Attributes['direction'] = 'down'))] AS pairs\n    FROM (\n        SELECT TimeUnix,\n               ServiceName,\n               Attributes,\n               StartTimeUnix,\n               greatest(Value - lagInFrame(Value, 1, 0)\n                        OVER (PARTITION BY MetricName, toString(Attributes), StartTimeUnix\n                              ORDER BY TimeUnix), 0) AS delta\n        FROM otel.otel_metrics_sum\n        WHERE MetricName = 'stunnel.udp.bytes'\n          AND ServiceName IN ('${client}', '${server}')\n    )\n    GROUP BY time, ServiceName\n)\nARRAY JOIN pairs AS pair\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "UDP bytes, total",
      "type": "timeseries"
    },
